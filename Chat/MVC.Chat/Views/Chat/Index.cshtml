@model ChatIndexViewModel
@{
    ViewData["Title"] = "Chat";
    Layout = null;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    * {
        box-sizing: border-box;
        font-family: 'Outfit', sans-serif;
    }

    body {
        background: #090c15;
        color: #ffffff;
        margin: 0;
        padding: 0;
    }

    .chat-wrapper {
        width: 100%;
        max-width: 1100px;
        height: 720px;
        margin: 20px auto;
        background: rgba(18, 16, 38, 0.65);
        backdrop-filter: blur(20px);
        border-radius: 24px;
        border: 1px solid rgba(0, 242, 254, 0.3);
        display: flex;
        overflow: hidden;
    }

    .sidebar {
        width: 320px;
        min-width: 320px;
        background: rgba(13, 11, 28, 0.5);
        border-right: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        flex-direction: column;
        padding: 24px 18px 18px 18px;
        gap: 16px;
        height: 100%;
    }

    .search-container {
        flex-shrink: 0;
    }

    .search-input {
        width: 100%;
        padding: 12px 16px;
        background: rgba(27, 24, 56, 0.7);
        border: 1px solid rgba(0, 242, 254, 0.3);
        border-radius: 12px;
        color: #fff;
        outline: none;
    }

    .user-list {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
        overflow-y: auto;
    }

    .user-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        background: rgba(30, 27, 60, 0.4);
        border-radius: 14px;
        cursor: pointer;
        transition: 0.3s;
    }

        .user-item.active {
            background: rgba(0, 242, 254, 0.15);
            border: 1px solid #00f2fe;
        }

    /* Sidebar Footer Fixed Row */
    .sidebar-footer {
        margin-top: auto;
        padding-top: 14px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        width: 100%;
        flex-shrink: 0;
    }

    .user-profile-info {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
        flex: 1;
    }

    .avatar-circle {
        width: 36px;
        height: 36px;
        min-width: 36px;
        border-radius: 50%;
        background: rgba(0, 242, 254, 0.15);
        border: 1px solid rgba(0, 242, 254, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #00f2fe;
        font-size: 14px;
    }

    .current-user-name {
        font-size: 13px;
        font-weight: 500;
        color: #e2e8f0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
    }

    .logout-form {
        margin: 0;
        padding: 0;
        display: flex;
    }

    .logout-btn {
        background: rgba(255, 75, 75, 0.12);
        border: 1px solid rgba(255, 75, 75, 0.3);
        color: #ff4b4b;
        width: 36px;
        height: 36px;
        min-width: 36px;
        border-radius: 10px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

        .logout-btn:hover {
            background: rgba(255, 75, 75, 0.3);
            border-color: #ff4b4b;
            color: #ffffff;
            box-shadow: 0 0 10px rgba(255, 75, 75, 0.4);
        }

    .chat-main {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        background: rgba(14, 12, 30, 0.3);
    }

    .chat-header {
        padding: 18px 28px;
        background: rgba(20, 17, 42, 0.6);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .chat-body {
        flex-grow: 1;
        padding: 24px 28px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .chat-empty-state {
        margin: auto;
        text-align: center;
        color: #8b8a9e;
    }

        .chat-empty-state i {
            font-size: 48px;
            margin-bottom: 12px;
            color: #00f2fe;
        }

    .message-row {
        display: flex;
        flex-direction: column;
        max-width: 65%;
    }

        .message-row.received {
            align-self: flex-start;
        }

        .message-row.sent {
            align-self: flex-end;
        }

    .message-bubble {
        padding: 12px 16px;
        border-radius: 16px;
        font-size: 14px;
        word-wrap: break-word;
    }

    .message-row.received .message-bubble {
        background: rgba(38, 32, 70, 0.7);
        color: #e2e8f0;
    }

    .message-row.sent .message-bubble {
        background: linear-gradient(135deg, #00f2fe, #4facfe);
        color: #090c15;
    }

    .chat-footer {
        padding: 20px 28px;
        background: rgba(20, 17, 42, 0.6);
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .input-container {
        display: flex;
        background: rgba(27, 24, 56, 0.8);
        border: 1px solid rgba(0, 242, 254, 0.3);
        border-radius: 18px;
        padding: 6px 12px;
    }

    .message-input {
        flex-grow: 1;
        background: transparent;
        border: none;
        outline: none;
        color: #fff;
        padding: 8px;
    }

    .send-btn {
        background: transparent;
        border: none;
        color: #00f2fe;
        font-size: 18px;
        cursor: pointer;
    }
</style>

<div class="chat-wrapper">
    <!-- Sidebar -->
    <div class="sidebar">
        <!-- Search Bar -->
        <div class="search-container">
            <input type="text" id="searchInput" class="search-input" placeholder="Search by name...">
        </div>

        <!-- Contact List -->
        <div class="user-list" id="userList">
            @foreach (var user in Model.Users)
            {
                <div class="user-item" data-userid="@user.UserId" onclick="openChat(this, @user.UserId, '@user.FullName')">
                    <span class="user-name-text">@user.FullName</span>
                </div>
            }
        </div>

        <!-- Sidebar Footer: Current User Profile & Logout -->
        <div class="sidebar-footer">
            <div class="user-profile-info">
                <div class="avatar-circle">
                    <i class="fa-solid fa-user"></i>
                </div>
                <span class="current-user-name" title="@Model.CurrentUserName">@Model.CurrentUserName</span>
            </div>

            <form asp-controller="Auth" asp-action="Logout" method="post" id="logoutForm" class="logout-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="logout-btn" title="Logout">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- Active Chat Panel -->
    <div class="chat-main">
        <!-- Header (Hidden until user selected) -->
        <div class="chat-header" id="chatHeader" style="display: none;">
            <div class="header-info">
                <h3 id="selectedUserName">User Name</h3>
            </div>
        </div>

        <!-- Chat Body -->
        <div class="chat-body" id="chatBody">
            <!-- Initial State when no user is selected -->
            <div class="chat-empty-state" id="emptyState">
                <i class="fa-solid fa-comments"></i>
                <p>Select a user from the left sidebar to start chatting</p>
            </div>
        </div>

        <!-- Footer Input (Hidden until user selected) -->
        <div class="chat-footer" id="chatFooter" style="display: none;">
            <div class="input-container">
                <input type="text" id="messageInput" class="message-input" placeholder="Type a message..." onkeypress="handleKeyPress(event)">
                <button class="send-btn" onclick="sendMessage()"><i class="fa-solid fa-paper-plane"></i></button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/microsoft/signalr/dist/browser/signalr.js"></script>
    <script>
        const currentUserId = @Model.CurrentUserId;
        let activeTargetUserId = null;

        // 1. SignalR Setup
        const connection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .withAutomaticReconnect()
        .build();

        connection.on("ReceiveMessage", function (senderId, message, timeStamp) {

        // Only render live message if chat with sender is currently active
        if (activeTargetUserId === senderId) {
        appendMessage(message, timeStamp, false);
        }
        });

        connection.start().catch(err => console.error(err));

        // 2. Open Chat via AJAX Request
        function openChat(element, targetUserId, fullName) {
        activeTargetUserId = targetUserId;

        // Highlight sidebar item
        document.querySelectorAll('.user-item').forEach(el => el.classList.remove('active'));
        element.classList.add('active');

        // Set Header & Show Controls
        document.getElementById('selectedUserName').innerText = fullName;
        document.getElementById('chatHeader').style.display = 'flex';
        document.getElementById('chatFooter').style.display = 'block';
        document.getElementById('emptyState').style.display = 'none';

        // Clear previous chat view
        const chatBody = document.getElementById('chatBody');
        chatBody.innerHTML = '';

        // Fetch Message History via AJAX
        fetch(`/Chat/GetConversation?targetUserId=${targetUserId}`)
        .then(res => res.json())
        .then(messages => {
        messages.forEach(msg => {
        const isSent = msg.senderId === currentUserId;
        const time = new Date(msg.sentAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        appendMessage(msg.content, time, isSent);
        });
        });
        }

        // 3. Send Message Handler
        function sendMessage() {
        const input = document.getElementById('messageInput');
        const content = input.value.trim();
        if (!content || !activeTargetUserId) return;

        const timeNow = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

        // Render locally
        appendMessage(content, timeNow, true);

        // Send via SignalR
        connection.invoke("SendMessageToUser", activeTargetUserId, content)
        .catch(err => console.error(err));

        input.value = '';
        }

        function handleKeyPress(e) {
        if (e.key === 'Enter') sendMessage();
        }

        function appendMessage(text, time, isSent) {
        const chatBody = document.getElementById('chatBody');
        const row = document.createElement('div');
        row.className = `message-row ${isSent ? 'sent' : 'received'}`;
        row.innerHTML = `<div class="message-bubble">${text}</div>`;
        chatBody.appendChild(row);
        chatBody.scrollTop = chatBody.scrollHeight;
        }

        // 4. Sidebar Search Filter
        document.getElementById('searchInput').addEventListener('input', function (e) {
        const query = e.target.value.toLowerCase();
        document.querySelectorAll('#userList .user-item').forEach(item => {
        const name = item.querySelector('.user-name-text').innerText.toLowerCase();
        item.style.display = name.includes(query) ? 'flex' : 'none';
        });
        });
    </script>
}