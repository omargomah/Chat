@model ChatIndexViewModel
@{
    ViewData["Title"] = "Chat";
    Layout = null;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    * {
        box-sizing: border-box;
        font-family: 'Outfit', sans-serif;
    }

    body {
        background: #090c15;
        color: #ffffff;
        margin: 0;
        padding: 0;
    }

    .chat-wrapper {
        width: 100%;
        max-width: 1100px;
        height: 720px;
        margin: 20px auto;
        background: rgba(18, 16, 38, 0.65);
        backdrop-filter: blur(20px);
        border-radius: 24px;
        border: 1px solid rgba(0, 242, 254, 0.3);
        display: flex;
        overflow: hidden;
    }

    .sidebar {
        width: 320px;
        min-width: 320px;
        background: rgba(13, 11, 28, 0.5);
        border-right: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        flex-direction: column;
        padding: 24px 18px 18px 18px;
        gap: 16px;
        height: 100%;
    }

    .search-container {
        flex-shrink: 0;
    }

    .search-input {
        width: 100%;
        padding: 12px 16px;
        background: rgba(27, 24, 56, 0.7);
        border: 1px solid rgba(0, 242, 254, 0.3);
        border-radius: 12px;
        color: #fff;
        outline: none;
    }

    .user-list {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
        overflow-y: auto;
    }

    .user-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        background: rgba(30, 27, 60, 0.4);
        border-radius: 14px;
        cursor: pointer;
        transition: 0.3s;
    }

    .user-item.active {
        background: rgba(0, 242, 254, 0.15);
        border: 1px solid #00f2fe;
    }

    /* Avatar & Status Indicator */
    .user-avatar-wrapper {
        position: relative;
        flex-shrink: 0;
    }

    .avatar-circle {
        width: 40px;
        height: 40px;
        min-width: 40px;
        border-radius: 50%;
        background: rgba(0, 242, 254, 0.15);
        border: 1px solid rgba(0, 242, 254, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #00f2fe;
        font-size: 16px;
    }

    .online-badge {
        position: absolute;
        bottom: 1px;
        right: 1px;
        width: 10px;
        height: 10px;
        background-color: #22c55e;
        border: 2px solid #090c15;
        border-radius: 50%;
    }

    /* Flex Content for Sidebar Row */
    .user-item-info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .user-item-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
    }

    .user-name-text {
        font-size: 14px;
        font-weight: 600;
        color: #f8fafc;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex: 1;
        min-width: 0;
    }

    .unread-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 22px;
        height: 22px;
        padding: 0 8px;
        border-radius: 999px;
        background: #ef4444;
        color: #ffffff;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .user-last-time {
        font-size: 11px;
        color: #94a3b8;
        white-space: nowrap;
    }

    .user-last-message {
        font-size: 12px;
        color: #64748b;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin: 0;
    }

    /* Sidebar Footer Fixed Row */
    .sidebar-footer {
        margin-top: auto;
        padding-top: 14px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        width: 100%;
        flex-shrink: 0;
    }

    .user-profile-info {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
        flex: 1;
    }

    .current-user-name {
        font-size: 13px;
        font-weight: 500;
        color: #e2e8f0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
    }

    .logout-form {
        margin: 0;
        padding: 0;
        display: flex;
    }

    .logout-btn {
        background: rgba(255, 75, 75, 0.12);
        border: 1px solid rgba(255, 75, 75, 0.3);
        color: #ff4b4b;
        width: 36px;
        height: 36px;
        min-width: 36px;
        border-radius: 10px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .logout-btn:hover {
        background: rgba(255, 75, 75, 0.3);
        border-color: #ff4b4b;
        color: #ffffff;
        box-shadow: 0 0 10px rgba(255, 75, 75, 0.4);
    }

    .chat-main {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        background: rgba(14, 12, 30, 0.3);
    }

    .chat-header {
        padding: 18px 28px;
        background: rgba(20, 17, 42, 0.6);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .chat-body {
        flex-grow: 1;
        padding: 24px 28px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .chat-empty-state {
        margin: auto;
        text-align: center;
        color: #8b8a9e;
    }

    .chat-empty-state i {
        font-size: 48px;
        margin-bottom: 12px;
        color: #00f2fe;
    }

    .message-row {
        display: flex;
        flex-direction: column;
        max-width: 65%;
    }

    .message-row.received {
        align-self: flex-start;
    }

    .message-row.sent {
        align-self: flex-end;
    }

    /* WhatsApp Bubble Layout Styles */
    .message-bubble {
        padding: 8px 12px;
        border-radius: 14px;
        font-size: 14px;
        word-wrap: break-word;
        display: inline-flex;
        flex-direction: column;
    }

    .message-row.received .message-bubble {
        background: rgba(38, 32, 70, 0.7);
        color: #e2e8f0;
    }

    .message-row.sent .message-bubble {
        background: linear-gradient(135deg, #00f2fe, #4facfe);
        color: #090c15;
    }

    .message-text {
        word-break: break-word;
    }

    .message-meta {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 4px;
        font-size: 10px;
        margin-top: 2px;
        align-self: flex-end;
    }

    .message-row.received .message-meta {
        color: #94a3b8;
    }

    .message-row.sent .message-meta {
        color: rgba(9, 12, 21, 0.7);
    }

    .status-ticks {
        font-size: 11px;
        line-height: 1;
    }

    .status-ticks.read {
        color: #0284c7;
        /* WhatsApp Blue */
    }

    .status-ticks.unread {
        color: rgba(9, 12, 21, 0.5);
        /* Gray */
    }

    .chat-footer {
        padding: 20px 28px;
        background: rgba(20, 17, 42, 0.6);
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .input-container {
        display: flex;
        background: rgba(27, 24, 56, 0.8);
        border: 1px solid rgba(0, 242, 254, 0.3);
        border-radius: 18px;
        padding: 6px 12px;
    }

    .message-input {
        flex-grow: 1;
        background: transparent;
        border: none;
        outline: none;
        color: #fff;
        padding: 8px;
    }

    .send-btn {
        background: transparent;
        border: none;
        color: #00f2fe;
        font-size: 18px;
        cursor: pointer;
    }
</style>

<div class="chat-wrapper">
    <!-- Sidebar -->
    <div class="sidebar">
        <!-- Search Bar -->
        <div class="search-container">
            <input type="text" id="searchInput" class="search-input" placeholder="Search by name...">
        </div>

        <!-- Contact List -->
        <div class="user-list" id="userList">
            @foreach (var user in Model.Users)
            {
                <div class="user-item" data-userid="@user.UserId" data-fullname="@user.FullName">

                    <div class="user-avatar-wrapper">
                        <div class="avatar-circle">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        @if (user.IsOnline)
                        {
                            <span class="online-badge" title="Online"></span>
                        }
                    </div>

                    <div class="user-item-info">
                        <div class="user-item-top">
                            <span class="user-name-text">@user.FullName</span>
                            @if (user.CountOfUnreadMessages > 0)
                            {
                                <span class="unread-badge" data-userid="@user.UserId">@user.CountOfUnreadMessages</span>
                            }
                            @if (user.LastMessageTime.HasValue)
                            {
                                <span class="user-last-time">
                                    @user.LastMessageTime.Value.ToString("hh:mm tt")
                                </span>
                            }
                        </div>
                        <p class="user-last-message">
                            @(string.IsNullOrEmpty(user.LastMessage) ? "No messages yet" : user.LastMessage)
                        </p>
                    </div>

                </div>
            }
        </div>

        <!-- Sidebar Footer -->
        <div class="sidebar-footer">
            <div class="user-profile-info">
                <div class="avatar-circle">
                    <i class="fa-solid fa-user"></i>
                </div>
                <span class="current-user-name" title="@Model.CurrentUserName">@Model.CurrentUserName</span>
            </div>

            <form asp-controller="Auth" asp-action="Logout" method="post" id="logoutForm" class="logout-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="logout-btn" title="Logout">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- Active Chat Panel -->
    <div class="chat-main">
        <div class="chat-header" id="chatHeader" style="display: none;">
            <div class="header-info">
                <h3 id="selectedUserName">User Name</h3>
            </div>
        </div>

        <div class="chat-body" id="chatBody">
            <div class="chat-empty-state" id="emptyState">
                <i class="fa-solid fa-comments"></i>
                <p>Select a user from the left sidebar to start chatting</p>
            </div>
        </div>

        <div class="chat-footer" id="chatFooter" style="display: none;">
            <div class="input-container">
                <input type="text" id="messageInput" class="message-input" placeholder="Type a message..."
                       onkeypress="handleKeyPress(event)">
                <button class="send-btn" onclick="sendMessage()"><i class="fa-solid fa-paper-plane"></i></button>
            </div>
        </div>
    </div>
</div>
<div id="messageContextMenu" class="context-menu" style="display: none;"></div>
<script src="~/microsoft/signalr/dist/browser/signalr.js"></script>
<script>
    const currentUserId = @Model.CurrentUserId;
    let activeTargetUserId = null;

    // 1. SignalR Setup
    const connection = new signalR.HubConnectionBuilder()
    .withUrl("/chatHub")
    .withAutomaticReconnect()
    .build();

    connection.on("ReceiveMessage", function (messageId, senderId, receiverId, message, timeStamp, lastUpdatedAt) {
    if (senderId === currentUserId) {
    return;
    }
    if (activeTargetUserId === senderId) {
    appendMessage(message, timeStamp, false, false, messageId, senderId, lastUpdatedAt);
    } else {
    incrementUnreadBadge(senderId);
    }
    updateSidebarPreview(senderId, message, timeStamp);
    });

    connection.on("MessageUpdated", function (messageId, senderId, receiverId, message, timeStamp, lastUpdatedAt) {
    if (senderId === currentUserId) {
    return;
    }
    if (activeTargetUserId === senderId) {
    updateMessageRow(messageId, message, timeStamp, true);
    } else {
    incrementUnreadBadge(senderId);
    }
    updateSidebarPreview(senderId, message, timeStamp);
    });

    connection.on("MessageDeleted", function (messageId, senderId, receiverId) {
    if (senderId === currentUserId) {
    return;
    }
    if (activeTargetUserId === senderId) {
    removeMessageRow(messageId);
    }
    });

    connection.on("MessageEdited", function (messageId, senderId, receiverId, message, timeStamp) {
    if (senderId === currentUserId) {
    return;
    }
    if (activeTargetUserId === senderId) {
    updateMessageRow(messageId, message, timeStamp, true);
    } else {
    incrementUnreadBadge(senderId);
    }
    updateSidebarPreview(senderId, message, timeStamp);
    });

    connection.on("UserOnline", function (userId) {
    setUserOnlineStatus(userId, true);
    });

    connection.on("UserOffline", function (userId) {
    setUserOnlineStatus(userId, false);
    });

    connection.start().catch(err => console.error(err));

    // 2. Open Chat via AJAX Request
    function openChat(element) {
    const userElement = element?.closest?.('.user-item');
    if (!userElement) {
    console.error('openChat could not resolve .user-item from element', element);
    return;
    }

    const targetUserId = Number(userElement.dataset.userid);
    const fullName = userElement.dataset.fullname || '';
    activeTargetUserId = targetUserId;

    if (Number.isNaN(targetUserId)) {
    console.error('Invalid targetUserId', userElement.dataset.userid);
    return;
    }

    console.log('openChat', activeTargetUserId, fullName);

    document.querySelectorAll('.user-item.active').forEach(el => el.classList.remove('active'));
    userElement.classList.add('active');

    const selectedUserNameEl = document.getElementById('selectedUserName');
    const chatHeaderEl = document.getElementById('chatHeader');
    const chatFooterEl = document.getElementById('chatFooter');
    const emptyStateEl = document.getElementById('emptyState');
    const chatBody = document.getElementById('chatBody');

    if (selectedUserNameEl) selectedUserNameEl.innerText = fullName;
    if (chatHeaderEl) chatHeaderEl.style.display = 'flex';
    if (chatFooterEl) chatFooterEl.style.display = 'block';
    if (emptyStateEl) emptyStateEl.style.display = 'none';
    if (chatBody) chatBody.innerHTML = '';

    const url = '/Chat/GetConversation?targetUserId=' + encodeURIComponent(targetUserId);
    console.log('fetching conversation', url);
    fetch(url)
    .then(res => {
    if (!res.ok) throw new Error('Network response was not ok ' + res.statusText);
    return res.json();
    })
    .then(messages => {
    updateUnreadBadge(targetUserId, 0);
    messages.forEach(msg => {
    const isSent = msg.senderId === currentUserId;
    const sentAt = msg.lastUpdatedAt ? msg.lastUpdatedAt : msg.sentAt;
    const time = new Date(sentAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    appendMessage(msg.content, time, isSent, msg.isRead, msg.id, msg.senderId, msg.lastUpdatedAt);
    });
    })
    .catch(err => {
    console.error('GetConversation failed', err);
    });
    }

    function updateSidebarPreview(userId, message, time) {
    const userItem = document.querySelector(`.user-item[data-userid="${userId}"]`);
    if (!userItem) return;

    const lastMessageEl = userItem.querySelector('.user-last-message');
    if (lastMessageEl) {
    lastMessageEl.textContent = message;
    }

    const topRow = userItem.querySelector('.user-item-top');
    if (!topRow) return;

    let lastTimeEl = topRow.querySelector('.user-last-time');
    if (!lastTimeEl) {
    lastTimeEl = document.createElement('span');
    lastTimeEl.className = 'user-last-time';
    topRow.appendChild(lastTimeEl);
    }
    lastTimeEl.textContent = time;
    }

    function updateUnreadBadge(userId, count) {
    const badge = document.querySelector(`.unread-badge[data-userid="${userId}"]`);
    if (!badge) return;
    if (count <= 0) {
    badge.remove();
    return;
    }
    badge.textContent = count;
    badge.style.display = 'inline-flex';
    }

    function incrementUnreadBadge(userId) {
    const badge = document.querySelector(`.unread-badge[data-userid="${userId}"]`);
    if (badge) {
    badge.textContent = String(Number(badge.textContent) + 1);
    return;
    }

    const userItem = document.querySelector(`.user-item[data-userid="${userId}"] .user-item-top`);
    if (!userItem) return;

    const newBadge = document.createElement('span');
    newBadge.className = 'unread-badge';
    newBadge.dataset.userid = userId;
    newBadge.textContent = '1';
    userItem.insertBefore(newBadge, userItem.querySelector('.user-last-time'));
    }

    function updateMessageRow(messageId, message, time, isEdited) {
    const row = document.querySelector(`.message-row[data-message-id="${messageId}"]`);
    if (!row) return;

    const textEl = row.querySelector('.message-text');
    if (textEl) {
    textEl.textContent = message;
    }

    const timeEl = row.querySelector('.message-time');
    if (timeEl) {
    timeEl.textContent = time;
    }

    let editedLabel = row.querySelector('.edited-label');
    if (isEdited) {
    if (!editedLabel && textEl) {
    editedLabel = document.createElement('span');
    editedLabel.className = 'edited-label';
    editedLabel.textContent = ' (edited)';
    textEl.after(editedLabel);
    }
    } else {
    editedLabel?.remove();
    }
    }

    function removeMessageRow(messageId) {
    const row = document.querySelector(`.message-row[data-message-id="${messageId}"]`);
    row?.remove();
    }

    function setUserOnlineStatus(userId, isOnline) {
    const avatarWrapper = document.querySelector(`.user-item[data-userid="${userId}"] .user-avatar-wrapper`);
    if (!avatarWrapper) return;

    const existingBadge = avatarWrapper.querySelector('.online-badge');
    if (isOnline) {
    if (!existingBadge) {
    const dot = document.createElement('span');
    dot.className = 'online-badge';
    dot.title = 'Online';
    avatarWrapper.appendChild(dot);
    }
    } else {
    existingBadge?.remove();
    }
    }

    function showMessageMenu(event, row) {
    event.preventDefault();
    if (row.dataset.isSent !== 'true' || !row.dataset.messageId) return;

    const menu = document.getElementById('messageContextMenu');
    menu.innerHTML = `
    <div class="context-menu-item" onclick="startEditMessage(${row.dataset.messageId})">Update</div>
    <div class="context-menu-item" onclick="deleteMessage(${row.dataset.messageId})">Delete</div>
    `;
    menu.style.left = `${event.pageX}px`;
    menu.style.top = `${event.pageY}px`;
    menu.style.display = 'block';
    }

    function hideMessageMenu() {
    const menu = document.getElementById('messageContextMenu');
    if (menu) menu.style.display = 'none';
    }

    document.addEventListener('click', hideMessageMenu);

    function startEditMessage(messageId) {
    hideMessageMenu();
    const row = document.querySelector(`.message-row[data-message-id="${messageId}"]`);
    if (!row) return;

    const textEl = row.querySelector('.message-text');
    if (!textEl) return;

    const newContent = prompt('Update message', textEl.textContent);
    if (newContent === null || newContent.trim() === '') return;

    const timeNow = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    updateMessageRow(messageId, newContent, timeNow, true);
    updateSidebarPreview(activeTargetUserId, newContent, timeNow);

    connection.invoke('UpdateMessage', messageId, newContent)
    .catch(err => console.error(err));
    }

    function deleteMessage(messageId) {
    hideMessageMenu();
    removeMessageRow(messageId);

    connection.invoke('DeleteMessage', messageId)
    .catch(err => console.error(err));
    }

    // 3. Send Message Handler
    function sendMessage() {
    const input = document.getElementById('messageInput');
    const content = input.value.trim();
    if (!content || !activeTargetUserId) return;

    const timeNow = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

    appendMessage(content, timeNow, true, false, null, currentUserId, null);
    updateSidebarPreview(activeTargetUserId, content, timeNow);

    connection.invoke("SendMessageToUser", activeTargetUserId, content)
    .then(messageId => assignMessageIdToLastSentRow(messageId))
    .catch(err => console.error(err));

    input.value = '';
    }

    function handleKeyPress(e) {
    if (e.key === 'Enter') sendMessage();
    }

    function assignMessageIdToLastSentRow(messageId) {
    if (!messageId) return;
    const rows = document.querySelectorAll('.message-row.sent');
    for (let i = rows.length - 1; i >= 0; i--) {
    const row = rows[i];
    if (!row.dataset.messageId) {
    row.dataset.messageId = messageId;
    break;
    }
    }
    }

    // 4. Append Message with Timestamp and Checkmarks
    function appendMessage(text, time, isSent, isRead = false, messageId = '', senderId = null, lastUpdatedAt = null) {
    const chatBody = document.getElementById('chatBody');
    const row = document.createElement('div');
    row.className = `message-row ${isSent ? 'sent' : 'received'}`;
    row.dataset.messageId = messageId ?? '';
    row.dataset.isSent = isSent ? 'true' : 'false';
    row.addEventListener('contextmenu', function (event) {
    showMessageMenu(event, row);
    });

    let statusHtml = '';
    if (isSent) {
    const tickClass = isRead ? 'read' : 'unread';
    statusHtml = `<span class="status-ticks ${tickClass}"><i class="fa-solid fa-check-double"></i></span>`;
    }

    row.innerHTML = `
    <div class="message-bubble">
    <span class="message-text">${text}</span>
    <div class="message-meta">
    <span class="message-time">${time}</span>
    ${statusHtml}
    </div>
    </div>
    `;

    if (lastUpdatedAt) {
    const editedLabel = document.createElement('span');
    editedLabel.className = 'edited-label';
    editedLabel.textContent = ' (edited)';
    row.querySelector('.message-bubble')?.appendChild(editedLabel);
    }

    chatBody.appendChild(row);
    chatBody.scrollTop = chatBody.scrollHeight;
    }

    // 5. Sidebar Search Filter
    document.getElementById('searchInput').addEventListener('input', function (e) {
    const query = e.target.value.toLowerCase();
    document.querySelectorAll('#userList .user-item').forEach(item => {
    const name = item.querySelector('.user-name-text').innerText.toLowerCase();
    item.style.display = name.includes(query) ? 'flex' : 'none';
    });
    });

    document.querySelectorAll('.user-item').forEach(item => {
    item.addEventListener('click', function () {
    openChat(this);
    });
    });
</script>