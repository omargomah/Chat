@model RegisterViewModel

@{
    ViewData["Title"] = "Register Form";
    Layout = null; // We're defining the full HTML structure here
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChatApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
            body {
                background-color: #0b2535; /* Dark teal background */
                color: #ffffff;
                font-family: Arial, sans-serif;
                display: flex;
                align-items: center;
                justify-content: center;
                height: 100vh;
                margin: 0;
                overflow: hidden; /* Prevent scrolling for the full-screen design */
            }

            .container {
                width: auto; /* Allow container to shrink to fit the card */
                max-width: 90%; /* For smaller screens */
            }

            .card {
                background: linear-gradient(135deg, rgba(200, 220, 255, 0.6) 0%, rgba(180, 200, 255, 0.4) 100%); /* Semi-transparent blue/lilac glass effect */
                border: none;
                border-radius: 20px;
                width: 300px;
                margin: 0 auto;
                backdrop-filter: blur(5px);
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
                overflow: hidden; /* Required for the border-radius to apply */
            }

            .card-body {
                padding: 30px;
            }

            h2 {
                text-align: center;
                font-weight: 300;
                font-size: 24px;
                margin-top: 0;
                margin-bottom: 25px;
                color: #ffffff; /* Lighter title color */
            }

            .form-label {
                display: none; /* Hide standard labels to make room for inputs */
            }

            .form-control {
                background-color: rgba(230, 230, 230, 0.8) !important; /* Lighter, semi-transparent input color */
                border: none;
                color: #333333;
                border-radius: 10px;
                padding: 10px 15px;
                margin-bottom: 15px;
            }

            .form-control::placeholder {
                color: #333333; /* Make placeholder text darker and visible */
            }

            .text-danger {
                color: #ffcccc !important; /* Lighter validation text on dark background */
            }

            .btn-register {
                background-color: #00d8ff;
                color: #000000; /* Black text for contrast */
                border: none;
                border-radius: 10px;
                padding: 10px 15px;
                width: 100%;
                margin-top: 10px;
                transition: background-color 0.3s ease;
            }

            .btn-register:hover {
                background-color: #00b0ff; /* Sightly darker blue on hover */
            }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 text-center">
                <div class="card">
                    <div class="card-body">
                        <h2>@ViewData["Title"]</h2>
                        <form asp-action="Register" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" placeholder="Email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ConfirmPassword" class="form-label"></label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="ConfirmPass" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="FName" class="form-label"></label>
                                <input asp-for="FName" class="form-control" placeholder="FName" />
                                <span asp-validation-for="FName" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="LName" class="form-label"></label>
                                <input asp-for="LName" class="form-control" placeholder="LName" />
                                <span asp-validation-for="LName" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Phone" class="form-label"></label>
                                <input asp-for="Phone" class="form-control" placeholder="Phone" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn btn-register">Register</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>