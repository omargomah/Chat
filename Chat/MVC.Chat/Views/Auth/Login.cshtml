@model LoginViewModel

@{
    ViewData["Title"] = "Login Form";
    Layout = null; // Standalone layout matching the custom theme style
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChatApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>

            body {
                background-color: #0b2535; /* Dark teal background */
                color: #ffffff;
                font-family: Arial, sans-serif;
                display: flex;
                align-items: center;
                justify-content: center;
                height: 100vh;
                margin: 0;
                overflow: hidden; /* Prevent scrolling for the full-screen design */
            }

            .container {
                width: auto; /* Allow container to shrink to fit the card */
                max-width: 90%; /* For smaller screens */
            }

            .card {
                background: linear-gradient(135deg, rgba(200, 220, 255, 0.6) 0%, rgba(180, 200, 255, 0.4) 100%); /* Semi-transparent blue/lilac glass effect */
                border: none;
                border-radius: 20px;
                width: 300px;
                margin: 0 auto;
                backdrop-filter: blur(5px);
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
                overflow: hidden; /* Required for the border-radius to apply */
            }

            .card-body {
                padding: 30px;
            }

            h2 {
                text-align: center;
                font-weight: 300;
                font-size: 24px;
                margin-top: 0;
                margin-bottom: 25px;
                color: #ffffff; /* Lighter title color */
            }

            .form-label {
                display: none; /* Hide standard labels to make room for inputs */
            }

            .form-control {
                background-color: rgba(230, 230, 230, 0.8) !important; /* Lighter, semi-transparent input color */
                border: none;
                color: #333333;
                border-radius: 10px;
                padding: 10px 15px;
                margin-bottom: 15px;
            }

                .form-control::placeholder {
                    color: #333333; /* Make placeholder text darker and visible */
                }

            .text-danger {
                color: #ffcccc !important; /* Lighter validation text on dark background */
            }


            .btn-login {
                background: transparent;
                color: #00d8ff;
                border: none;
                text-decoration: underline;
                font-size: 16px;
                cursor: pointer;
                padding: 5px 10px;
                transition: color 0.3s ease;
            }

            .btn-login:hover {
                color: #ffffff;
            }

            .register-link {
                display: block;
                margin-top: 15px;
                font-size: 13px;
                color: #e0e0e0;
                text-decoration: none;
            }

            .register-link:hover {
                color: #00d8ff;
            }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 text-center">
                <div class="card">
                    <div class="card-body">
                        <h2>Login Form</h2>
                        <form asp-action="Login"  method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" placeholder="Email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <!-- Styled like the underline Login button in your wireframe -->
                            <button type="submit" class="btn btn-login">Login</button>
                        </form>

                        <div>
                            <a asp-action="Register" asp-controller="Auth" class="register-link">Don't have an account? Register</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>